\begin_layout Plain Layout

% create segmentation
\end_layout

\begin_layout Plain Layout

seg = areaOpening(killBorders(seg > 160),
 10);
\end_layout

\begin_layout Plain Layout

% crop with bounding box
\end_layout

\begin_layout Plain Layout

box = regionBoundingBox(seg);
\end_layout

\begin_layout Plain Layout

resCrop = crop(img,
 box);
\end_layout

\begin_layout Plain Layout

% crop with oriented bounding box
\end_layout

\begin_layout Plain Layout

obox = regionOrientedBox(seg);
\end_layout

\begin_layout Plain Layout

resCrop2 = cropOrientedBox(img,
 obox);
\end_layout

\end_inset


\end_layout

